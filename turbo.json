{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "ZOG_HOME",
    "ZOG_DESKTOP_WS_URL",
    "ZOG_BROWSER_HOST_PIPE_PATH",
    "ZOG_BROWSER_USE_PIPE_PATH",
    "ZOG_BROWSER_PERF",
    "ZOG_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "ZOG_GROK_ACP_DEBUG",
    "ZOG_WEB_SOURCEMAP",
    "ZOG_SERVER_SOURCEMAP",
    "ZOG_DESKTOP_SOURCEMAP",
    "ZOG_MODE",
    "ZOG_PORT",
    "ZOG_NO_BROWSER",
    "ZOG_AUTH_TOKEN",
    "ZOG_PUBLIC_URL",
    "ZOG_ALLOW_INSECURE_REMOTE",
    "ZOG_LOG_WS_EVENTS",
    "ZOG_HOST",
    "ZOG_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
